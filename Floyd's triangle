#include <stdio.h>

int main() {
    int rows, i, j, val = 1;

    // Assume rows is input by the user (e.g., 5)
    scanf("%d", &rows);

    for (i = 1; i <= rows; i++) {
        for (j = 1; j <= i; j++) {
            printf("%d ", val);
            val++;
        }
        printf("\n");
    }

    return 0;
}
