#include <stdio.h>

int main() {
    int rows, i, j, space, num;

    printf("Enter number of rows: ");
    scanf("%d", &rows);

    for (i = 0; i < rows; i++) {
        // Print leading spaces for alignment
        for (space = 1; space <= rows - i; space++)
            printf("  ");

        num = 1;
        for (j = 0; j <= i; j++) {
            printf("%4d", num);
            // Calculate next term based on the current term
            num = num * (i - j) / (j + 1);
        }
        printf("\n");
    }

    return 0;
}
