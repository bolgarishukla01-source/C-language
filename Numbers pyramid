#include <stdio.h>

int main() {
    int rows, i, j, space;

    printf("Enter number of rows : ");
    scanf("%d", &rows);

    for (i = 0; i < rows; i++) {
        for (space = 1; space <= rows - i - 1; space++) {
            printf(" ");
        }
        for (j = 0; j < (2 * i + 1); j++) {
            printf("%d", i);
        }

        printf("\n");
    }

    return 0;
}
